# Copy to deploy/.env on the server (never commit the real file).
DEPLOY_ENV=staging            # or production
IMAGE_TAG=latest              # set by the deploy workflow to the commit SHA

# Public hostnames (put a reverse proxy with HTTPS — e.g. Caddy — in front)
WEB_HOST=staging.kijitalk.example
AUTH_HOST=auth.staging.kijitalk.example

# Secrets — generate long random values, e.g.  openssl rand -base64 48
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
AUTH_JWT_SECRET=
INTERNAL_API_KEY=

ADMIN_EMAILS=you@example.com
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=

# Razorpay (use test keys on staging)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=

# GST invoice seller details
SELLER_LEGAL_NAME=Kiji Technology
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_STATE=

# Email (both services)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=KijiTalk <no-reply@kijitalk.example>

# Error tracking (optional)
SENTRY_DSN_API=
SENTRY_DSN_AUTH=
