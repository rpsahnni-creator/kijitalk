{
  "name": "KijiTalk Design System",
  "version": "1.0.0",
  "colors": {
    "brand": {
      "50": "#eef2ff",
      "100": "#e0e7ff",
      "200": "#c7d2fe",
      "300": "#a5b4fc",
      "400": "#818cf8",
      "500": "#6366f1",
      "600": "#4f46e5",
      "700": "#4338ca",
      "800": "#3730a3",
      "900": "#312e81"
    },
    "semantic": {
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#3b82f6"
    },
    "neutral": {
      "light-bg": "#f8fafc",
      "dark-bg": "#0f172a",
      "light-surface": "#ffffff",
      "dark-surface": "#1e293b",
      "light-text": "#0f172a",
      "dark-text": "#f8fafc",
      "muted": "#64748b"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "Inter",
      "display": "Cal Sans"
    },
    "scale": {
      "xs": { "size": "12px", "lineHeight": "16px", "weight": 400 },
      "sm": { "size": "14px", "lineHeight": "20px", "weight": 400 },
      "base": { "size": "16px", "lineHeight": "24px", "weight": 400 },
      "lg": { "size": "18px", "lineHeight": "28px", "weight": 500 },
      "xl": { "size": "20px", "lineHeight": "28px", "weight": 600 },
      "2xl": { "size": "24px", "lineHeight": "32px", "weight": 700 },
      "3xl": { "size": "30px", "lineHeight": "36px", "weight": 700 },
      "4xl": { "size": "36px", "lineHeight": "40px", "weight": 800 },
      "5xl": { "size": "48px", "lineHeight": "52px", "weight": 800 }
    }
  },
  "spacing": {
    "unit": 4,
    "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96]
  },
  "borderRadius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "32px",
    "full": "9999px"
  },
  "shadows": {
    "card": "0 4px 24px rgba(0,0,0,0.08)",
    "cardDark": "0 4px 24px rgba(0,0,0,0.3)",
    "button": "0 4px 14px rgba(79,70,229,0.25)"
  },
  "components": {
    "buttonPrimary": {
      "background": "#4f46e5",
      "color": "#ffffff",
      "borderRadius": "16px",
      "padding": "12px 24px",
      "fontWeight": 600
    },
    "buttonSecondary": {
      "background": "#ffffff",
      "border": "1px solid #e2e8f0",
      "color": "#334155",
      "borderRadius": "16px",
      "padding": "12px 24px"
    },
    "input": {
      "background": "#ffffff",
      "border": "1px solid #e2e8f0",
      "borderRadius": "16px",
      "padding": "12px 16px",
      "focusRing": "#6366f1"
    },
    "card": {
      "background": "#ffffff",
      "borderRadius": "24px",
      "padding": "24px",
      "shadow": "card"
    }
  },
  "accessibility": {
    "minContrastRatio": 4.5,
    "minTouchTarget": "44px",
    "minFontSize": "14px",
    "focusVisible": "2px solid #6366f1"
  }
}
