generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TargetLevel {
  beginner
  intermediate
  advanced
}

enum ActivityType {
  lesson
  chat
  roleplay
  voice
  call
  debate
}

enum ChatType {
  free
  grammar
  roleplay
}

enum MessageRole {
  user
  assistant
}

enum SubscriptionTier {
  free
  premium
}

enum PaymentStatus {
  created
  paid
  failed
}

// Mirrors Razorpay subscription states.
enum SubscriptionStatus {
  created
  authenticated
  active
  pending
  halted
  cancelled
  completed
  expired
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  passwordHash        String?
  googleId            String?     @unique
  // Legacy column from the earlier Firebase-auth setup; unused by current code,
  // kept nullable instead of dropped to avoid a destructive migration over live data.
  firebaseUid         String?     @unique
  displayName         String      @default("Learner")
  avatarUrl           String?
  nativeLanguage      String      @default("hi")
  targetLevel         TargetLevel @default(beginner)
  grade               String?
  board               String?
  state               String?
  learningGoal        String?
  onboardingCompleted Boolean     @default(false)

  subscriptionTier      SubscriptionTier @default(free)
  // null while on the free tier, or once never purchased. See subscription.service.ts#effectiveTier
  // for the lazy downgrade-on-read check — nothing cron-based flips this back to free.
  subscriptionExpiresAt DateTime?
  // Resets to 0 whenever aiUsageResetAt rolls past the current day (see subscription.service.ts).
  aiMessagesToday  Int              @default(0)
  aiUsageResetAt   DateTime         @default(now())

  streak         Int      @default(0)
  streakFreezes  Int      @default(1)
  totalMinutes   Int      @default(0)
  lessonsCompleted Int    @default(0)
  xp             Int      @default(0)
  coins          Int      @default(50)
  level          Int      @default(1)
  badges         String[] @default([])

  // Nested settings blob (dark mode, notifications, voice prefs) — kept as JSON
  // since it is read/written as a single object everywhere it is used.
  settings Json @default("{\"darkMode\":false,\"notifications\":true,\"dailyGoalMinutes\":15,\"hindiLabels\":true,\"voiceSpeed\":0.9,\"accent\":\"indian\"}")

  lastActiveAt DateTime @default(now())
  // Set when the learner deletes their account. Personal data is wiped right
  // away; the row stays only so payment/invoice records required by GST law
  // keep a valid owner.
  deletedAt    DateTime?

  // Placement test result (spoken + written), used to set targetLevel.
  placementScore Int?
  placementAt    DateTime?

  // Premium granted through a school licence (B2B), kept denormalised so
  // usage checks stay synchronous. Refreshed when the learner joins a class
  // or the school's licence changes.
  schoolLicenseUntil DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress     Progress[]
  chatSessions ChatSession[]
  mistakeLogs  MistakeLog[]
  payments      Payment[]
  subscriptions Subscription[]
  invoices      Invoice[]
  schoolRoles   SchoolStaff[]
  classesTaught Classroom[]   @relation("ClassTeacher")
  memberships   ClassMember[]

  @@map("users")
}

model Lesson {
  id              String      @id @default(cuid())
  title           String      @unique
  description     String
  level           TargetLevel
  category        String
  durationMinutes Int         @default(10)
  vocabulary      String[]    @default([])
  phrases         String[]    @default([])

  // Array of exercise objects; heterogeneous shape per exercise type
  // (mcq/match/word-bank carry extra fields), so JSON fits better than a fixed table.
  exercises Json @default("[]")

  order     Int      @default(0)
  isActive  Boolean  @default(true)
  tags      String[] @default([])
  gradeBand String?

  // Semantic embedding of title+description+category+vocabulary+phrases, used for
  // RAG (grammar grounding, smart search). Plain Float[] + app-side cosine similarity —
  // no pgvector, since this Postgres install doesn't have it and 500-ish rows needs no index.
  embedding Float[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress Progress[]

  @@map("lessons")
}

model MistakeLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  original  String
  corrected String
  topic     String?
  embedding Float[]  @default([])
  createdAt DateTime @default(now())

  // Spaced repetition (Leitner boxes 0–5): a correct review moves the card up
  // a box and further out in time; a miss sends it back to box 0.
  box            Int       @default(0)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?
  reviewCount    Int       @default(0)

  @@index([userId, createdAt])
  @@index([userId, nextReviewAt])
  @@map("mistake_logs")
}

model Progress {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId           String?
  lesson             Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  date               DateTime     @default(now())
  minutesSpent       Int          @default(0)
  score              Int          @default(0)
  pronunciationScore Int?
  activityType       ActivityType
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@map("progress")
}

model ChatSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @default("New Conversation")
  type       ChatType @default(free)
  roleplayId String?
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        MessageRole
  content     String
  corrections String[]    @default([])
  timestamp   DateTime    @default(now())

  @@index([sessionId, timestamp])
  @@map("chat_messages")
}

model Payment {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id])
  // One-off orders have an order id; subscription charges have a subscription id.
  razorpayOrderId        String?       @unique
  razorpaySubscriptionId String?
  razorpayPaymentId      String?       @unique
  amountInr              Int
  status                 PaymentStatus @default(created)
  invoice                Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([razorpaySubscriptionId])
  @@map("payments")
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  user                   User               @relation(fields: [userId], references: [id])
  razorpaySubscriptionId String             @unique
  planId                 String
  status                 SubscriptionStatus @default(created)
  currentStart           DateTime?
  currentEnd             DateTime?
  // The learner asked to stop renewing; premium lasts until currentEnd.
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

// A GST tax invoice for one successful payment. Amounts are in paise and the
// seller/buyer details are snapshotted so an issued invoice never changes.
model Invoice {
  id            String    @id @default(cuid())
  number        String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  paymentId     String    @unique
  payment       Payment   @relation(fields: [paymentId], references: [id])
  issuedAt      DateTime  @default(now())
  buyerName     String
  buyerEmail    String
  buyerState    String?
  placeOfSupply String
  description   String
  sacCode       String
  taxablePaise  Int
  cgstPaise     Int       @default(0)
  sgstPaise     Int       @default(0)
  igstPaise     Int       @default(0)
  totalPaise    Int
  seller        Json
  emailedAt     DateTime?

  @@index([userId, issuedAt])
  @@map("invoices")
}

// Gap-free invoice numbering per Indian financial year (e.g. "2026-27").
model InvoiceCounter {
  financialYear String @id
  lastNumber    Int    @default(0)

  @@map("invoice_counters")
}

// Razorpay retries webhooks; remembering event ids makes handling idempotent.
model WebhookEvent {
  id         String   @id
  event      String
  receivedAt DateTime @default(now())

  @@map("webhook_events")
}

// One row per AI tutor call, for usage and reliability monitoring.
model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String?
  feature   String
  provider  String
  ok        Boolean
  fallback  Boolean  @default(false)
  latencyMs Int
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([provider, createdAt])
  @@map("ai_usage_logs")
}

// ── Schools (B2B) ──────────────────────────────────────────────────────────

model School {
  id               String    @id @default(cuid())
  name             String
  city             String?
  state            String?
  contactEmail     String?
  gstin            String?
  seats            Int       @default(0)
  licenseExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  staff      SchoolStaff[]
  classrooms Classroom[]

  @@map("schools")
}

model SchoolStaff {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("teacher") // "owner" | "teacher"
  createdAt DateTime @default(now())

  @@unique([schoolId, userId])
  @@map("school_staff")
}

model Classroom {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("ClassTeacher", fields: [teacherId], references: [id])
  name      String
  grade     String?
  joinCode  String   @unique
  createdAt DateTime @default(now())

  members     ClassMember[]
  assignments Assignment[]

  @@index([schoolId])
  @@map("classrooms")
}

model ClassMember {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([classroomId, userId])
  @@index([userId])
  @@map("class_members")
}

model Assignment {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  lessonId    String
  note        String?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())

  @@index([classroomId])
  @@map("assignments")
}
