# Backend
NODE_ENV=development
PORT=4001
CORS_ORIGIN=http://localhost:3100

# PostgreSQL (local install, or a free Supabase/Neon/Railway instance)
DATABASE_URL=postgresql://USER:PASS@localhost:5432/kijitalk?schema=public

# Google Gemini (FREE tier — default tutor model)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude (optional — powers the "Premium" tutor tier if set)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Self-hosted auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Google Sign-In (optional) — Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=

# Python Speech Service
SPEECH_SERVICE_URL=http://localhost:5001
WHISPER_MODEL=base
EDGE_TTS_VOICE=en-IN-NeerjaNeural

LOG_LEVEL=info
