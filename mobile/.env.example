EXPO_PUBLIC_API_URL=http://localhost:4001
# Web app URL — used to open Premium checkout (Razorpay has no Expo-Go-compatible
# native SDK, so this opens the web app's working checkout flow in the browser instead).
EXPO_PUBLIC_WEB_URL=http://localhost:3100

# Auth service (Django) — sign-in, sessions, password reset
EXPO_PUBLIC_AUTH_URL=http://localhost:8100
