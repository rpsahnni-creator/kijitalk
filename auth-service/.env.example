# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Same Postgres database as backend/.env (Django keeps its tables in the "auth" schema)
DATABASE_URL=postgresql://postgres:password@localhost:5432/kijitalk
AUTH_DB_SCHEMA=auth

# Shared with backend/.env AUTH_JWT_SECRET — the Node API verifies tokens with it (min 32 chars)
AUTH_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Where links in emails point, and which apps may call this service
FRONTEND_URL=http://localhost:3100
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:8081

# Optional: Google sign-in (same Web client ID as the frontend)
GOOGLE_CLIENT_ID=

# Email — prints to the console by default. For real mail use SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=KijiTalk <no-reply@kijitalk.local>

# Account deletion also wipes the learner profile in the Node API.
# Same random value as backend/.env INTERNAL_API_KEY (min 32 chars).
NODE_API_URL=http://localhost:4001
INTERNAL_API_KEY=change-me-to-a-random-secret-of-at-least-32-characters
