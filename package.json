{
  "name": "kijitalk",
  "version": "1.0.0",
  "private": true,
  "description": "KijiTalk — English speaking practice app (monorepo)",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install --prefix mobile",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:mobile": "npm run start --prefix mobile",
    "dev:speech": "cd speech-service && python main.py",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "setup:env": "node scripts/setup-env.js"
  }
}
